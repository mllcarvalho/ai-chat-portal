{
  "name": "ai-chat-portal-extension",
  "displayName": "BMAD Product Studio",
  "description": "Chat com os modelos do GitHub Copilot direto do navegador — projetos, sessões, skills, agentes, bases de conhecimento e MCPs, 100% local",
  "version": "0.5.2",
  "publisher": "aichatportal",
  "author": "Matheus Llobregat (https://github.com/mllcarvalho)",
  "private": true,
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0b101b",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mllcarvalho/ai-chat-portal.git"
  },
  "keywords": [
    "copilot",
    "chat",
    "ai",
    "agent",
    "mcp",
    "bmad"
  ],
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiChatPortal.openInBrowser",
        "title": "BMAD Product Studio: Abrir no Navegador"
      },
      {
        "command": "aiChatPortal.copyUrl",
        "title": "BMAD Product Studio: Copiar URL do Portal"
      },
      {
        "command": "aiChatPortal.warmup",
        "title": "BMAD Product Studio: Autorizar uso do Copilot"
      }
    ],
    "configuration": {
      "title": "BMAD Product Studio",
      "properties": {
        "aiChatPortal.hostedPortalUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Portal hospedado pela empresa (ex.: `https://portal.empresa.com`). Quando definido, \"Abrir no Navegador\" e o instalador abrem essa URL apontando para a extensão desta máquina (`?server=http://127.0.0.1:PORT`). Vazio = a extensão serve a interface localmente. Tem precedência sobre o valor salvo na tela de configurações do portal."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@aiportal/shared": "*",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "turndown": "^7.2.4",
    "undici": "^6.21.0",
    "unpdf": "^1.3.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
